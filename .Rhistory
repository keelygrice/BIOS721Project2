library(dplyr)
library(ggplot2)
library(lubridate)
# Compute monthly averages by year
pm_monthly <- all_data %>%
mutate(
Month = month(Date, label = TRUE, abbr = TRUE)
) %>%
group_by(Year, Month) %>%
summarise(
mean_PM = mean(mean_PM2.5, na.rm = TRUE),
sd_PM   = sd(mean_PM2.5, na.rm = TRUE),
n_PM    = sum(!is.na(mean_PM2.5)),
.groups = "drop"
) %>%
mutate(
se_PM = sd_PM / sqrt(n_PM),
CI_low = mean_PM - 1.96 * se_PM,
CI_up  = mean_PM + 1.96 * se_PM
)
ggplot(pm_monthly, aes(x = Month, y = mean_PM, color = factor(Year), group = Year)) +
geom_line(size = 1) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = CI_low, ymax = CI_up), width = 0.15) +
labs(
title = "Monthly Average PM2.5 Concentrations by Year",
x = "Month",
y = "PM2.5 Concentration (µg/m³)",
color = "Year"
) +
theme_bw()
