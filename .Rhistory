year1 <- read.csv("AQ_2018.csv")
year2 <- read.csv("AQ_2019.csv")
year3 <- read.csv("AQ_2020.csv")
#function to clean data
cleaner <- function(df){
#replace col names
names(df)[2] <- "max_CO"
names(df)[4] <- "mean_PM2.5"
names(df)[6] <- "max_Ozone"
#format date
df$Date <- as.Date(df$Date, format = "%m/%d/%Y")
#average by day and delete duplicate cols
df_clean <- df %>%
group_by(Date) %>%
summarise(
max_CO = mean(max_CO, na.rm = TRUE),
units_CO = first(units_CO),
mean_PM2.5 = mean(mean_PM2.5, na.rm = TRUE),
units_PM = first(units_PM),
max_Ozone = mean(max_Ozone, na.rm = TRUE),
units_O3 = first(units_O3)
) %>%
ungroup()
#remove negative values, replace with 0
for (i in c(2, 4, 6)){
df_clean[,i][df_clean[,i] < 0] <- 0}
return(df_clean)
}
#apply function to data
cleaner(year1)
#apply function to data
year1_clean <- cleaner(year1)
year2_clean <- cleaner(year2)
year3_clean <- cleaner(year3)
library(lubridate)
#add month variable
all_data <- all_data %>%
mutate(Month = month(Date, label = TRUE, abbr = TRUE))
#combine data
all_data <- bind_rows(
year1_clean %>% mutate(Year = 1),
year2_clean %>% mutate(Year = 2),
year3_clean %>% mutate(Year = 3)
)
#add month variable
all_data <- all_data %>%
mutate(Month = month(Date, label = TRUE, abbr = TRUE))
#reformat for ggplot
library(tidyr)
plot_df <- monthly_df %>%
pivot_longer(
cols = c(mean_CO, mean_O3, CI_low_CO, CI_up_CO, CI_low_O3, CI_up_O3),
names_to = c("Pollutant", ".value"),
names_pattern = "(.*)_(.*)"
)
#reformat and calculate monthly average, se, and CI
monthly_df <- all_data %>%
group_by(Month) %>%
summarise(
mean_CO = mean(max_CO, na.rm = TRUE),
sd_CO   = sd(max_CO, na.rm = TRUE),
n_CO    = sum(!is.na(max_CO)),
mean_O3 = mean(max_Ozone, na.rm = TRUE),
sd_O3   = sd(max_Ozone, na.rm = TRUE),
n_O3    = sum(!is.na(max_Ozone))
) %>%
mutate(
se_CO = sd_CO / sqrt(n_CO),
se_O3 = sd_O3 / sqrt(n_O3),
CI_low_CO = mean_CO - 1.96 * se_CO,
CI_up_CO  = mean_CO + 1.96 * se_CO,
CI_low_O3 = mean_O3 - 1.96 * se_O3,
CI_up_O3  = mean_O3 + 1.96 * se_O3
)
#reformat for ggplot
library(tidyr)
plot_df <- monthly_df %>%
pivot_longer(
cols = c(mean_CO, mean_O3, CI_low_CO, CI_up_CO, CI_low_O3, CI_up_O3),
names_to = c("Pollutant", ".value"),
names_pattern = "(.*)_(.*)"
)
#plot
library(ggplot2)
ggplot(plot_df, aes(x = Month, y = mean, color = Pollutant, group = Pollutant)) +
geom_point(size = 3) +
geom_line(size = 1) +
geom_errorbar(aes(ymin = low, ymax = up), width = 0.15) +
labs(
x = "Month",
y = "Concentration",
color = "Pollutant",
title = "Monthly Average CO and O₃ Concentrations (Averaged Over 3 Years)",
subtitle = "Error bars represent 95% confidence intervals"
) +
theme_classic()
#plot
ggplot(plot_df, aes(x = Month, y = mean, color = Pollutant)) +
geom_point(size = 3) +
geom_line(size = 1) +
geom_errorbar(aes(ymin = low, ymax = up), width = 0.15) +
labs(
x = "Month",
y = "Concentration",
color = "Pollutant",
title = "Monthly Average CO and O₃ Concentrations (Averaged Over 3 Years)",
subtitle = "Error bars represent 95% confidence intervals"
) +
theme_classic()
